# 复制为 .env 后使用（.env 已在 .gitignore 中，不会被提交）
# 仅用于本地开发，不要与任何线上环境复用

# --- Redis ---
REDIS_PASSWORD=collabhub_dev_pwd

# --- RabbitMQ ---
RABBITMQ_USER=collabhub
RABBITMQ_PASSWORD=collabhub_dev_pwd

# --- MinIO ---
MINIO_ROOT_USER=collabhub
MINIO_ROOT_PASSWORD=collabhub_dev_pwd

# --- Spring Boot 连接串（写进 application-local.yml 时参考）---
# MySQL 是宿主机原生服务，容器要从 host.docker.internal 访问，应用直接用 localhost
# MYSQL_URL=jdbc:mysql://localhost:3306/collabhub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# MYSQL_USER=collabhub
# MYSQL_PASSWORD=collabhub_dev_pwd
